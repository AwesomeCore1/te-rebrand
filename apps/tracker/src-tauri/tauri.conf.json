{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tacho",
  "version": "0.1.0",
  "identifier": "app.tacho.tracker",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tacho",
        "width": 1040,
        "height": 680,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/scs-telemetry/scs-telemetry.dll": "scs-telemetry/scs-telemetry.dll",
      "resources/scs-telemetry/LICENSE.txt": "scs-telemetry/LICENSE.txt"
    }
  }
}
