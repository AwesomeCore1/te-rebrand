# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# The site's public URL; it appears in links we send out, so it's not a secret.
# @type=url @sensitive=false
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Discord application (https://discord.com/developers/applications) > OAuth2.
# Redirect URL: ${BETTER_AUTH_URL}/api/auth/callback/discord
# Public: it's part of every Discord login link.
# @type=string(minLength=1) @sensitive=false
DISCORD_CLIENT_ID=

# @type=string(minLength=1)
DISCORD_CLIENT_SECRET=

# Optional: Steam Web API key, to show the linked Steam persona name.
# Linking itself (Steam OpenID) works without it.
# @required=false
STEAM_WEB_API_KEY=

# ---- Live map background (/map), all optional -------------------------------
# With none of these set, the map is a dark panel with a coordinate grid.
# Tacho ships no map images: point these at tiles you host or may use.
#
# TILE_URL     Leaflet tile URL template: https://tiles.example.com/ets2/{z}/{x}/{y}.png
# BOUNDS       Where the tiles sit in the game world, as "x1,z1,x2,z2" in game
#              metres: the game x and z at the top-left corner of the whole map
#              image, then at its bottom-right corner. The image must be one
#              square tile at zoom 0. (In a ts-map TileMapInfo.json these are
#              x1, y1, x2, y2.) Needed whenever TILE_URL is set.
# MAX_ZOOM     Deepest zoom level the tiles have. Default 8.
# TILE_SIZE    Tile edge in pixels. Default 256.
# ATTRIBUTION  Credit line shown on the map, plain text.

# @required=false @sensitive=false
LIVE_MAP_ETS2_TILE_URL=
# @required=false @sensitive=false
LIVE_MAP_ETS2_BOUNDS=
# @required=false @sensitive=false
LIVE_MAP_ETS2_MAX_ZOOM=
# @required=false @sensitive=false
LIVE_MAP_ETS2_TILE_SIZE=
# @required=false @sensitive=false
LIVE_MAP_ETS2_ATTRIBUTION=

# @required=false @sensitive=false
LIVE_MAP_ATS_TILE_URL=
# @required=false @sensitive=false
LIVE_MAP_ATS_BOUNDS=
# @required=false @sensitive=false
LIVE_MAP_ATS_MAX_ZOOM=
# @required=false @sensitive=false
LIVE_MAP_ATS_TILE_SIZE=
# @required=false @sensitive=false
LIVE_MAP_ATS_ATTRIBUTION=

# ---- Tracker download (/download), optional ---------------------------------
# Link to the Windows installer of the tracker, for example a GitHub Releases
# asset: https://github.com/<owner>/<repo>/releases/latest/download/<file>.exe
# Without it, /download says the tracker is not released yet.
# @required=false @sensitive=false @type=url
TRACKER_DOWNLOAD_URL=
