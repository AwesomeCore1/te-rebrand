# The database is the website's: its URL comes from apps/web/.env.
# @import(../web/, pick=[NODE_ENV, DATABASE_*])
# @defaultSensitive=true
# ---

# Bot token: Discord developer portal > your application > Bot > Reset Token.
# Put it in apps/bot/.env (git-ignored). Without it the bot starts, says so and
# posts nothing. See apps/bot/README.md.
# @required=false @type=string(minLength=1)
DISCORD_BOT_TOKEN=
