// Domain tables from docs/PLAN.md ("Data model").
// Distances are always km. Every company-owned table has companyId.

enum UnitPreference {
  km
  mi
}

enum Game {
  ets2
  ats
}

enum MembershipRole {
  owner
  manager
  driver
}

enum MembershipStatus {
  pending
  active
  inactive // left the VTC on TruckersMP (nightly check)
  left
  removed
}

enum ApplicationStatus {
  pending
  accepted
  rejected
  withdrawn
}

enum JobStatus {
  delivered
  cancelled
  flagged
  rejected // a manager turned down a flagged job; it never counts
}

enum GoalMetric {
  km
  jobs
  income
}

/// One profile per person, shared across companies.
model Driver {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String
  steamId64      String?        @unique
  truckersmpId   Int?           @unique
  unitPreference UnitPreference @default(km)
  showOnLiveMap  Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  memberships     Membership[]
  applications    Application[]
  jobs            Job[]
  trackerDevices  TrackerDevice[]
  trackerPairings TrackerPairing[]

  @@map("driver")
}

/// One row per VTC on the platform.
/// Convoys and events live on TruckersMP; we show the VTC's events by
/// truckersmpVtcId (packages/truckersmp) and store none of our own.
model Company {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  tag             String?
  logoUrl         String?
  truckersmpVtcId Int?      @unique
  verifiedAt      DateTime?
  discordGuildId  String?
  /// Discord channel ids, recruitment questions and other per-company settings.
  settings        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships  Membership[]
  applications Application[]
  ranks        Rank[]
  jobs         Job[]
  goals        Goal[]
  outbox       OutboxEvent[]
  botPosts     BotPost[]
  botStatus    BotStatus?

  @@map("company")
}

/// Who is in which company. History is kept when someone leaves.
model Membership {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driverId       String
  driver         Driver           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  role           MembershipRole   @default(driver)
  status         MembershipStatus @default(active)
  joinedAt       DateTime         @default(now())
  leftAt         DateTime?
  lastVtcCheckAt DateTime?

  @@index([companyId, status])
  @@index([driverId, status])
  @@map("membership")
}

model Application {
  id        String            @id @default(cuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driverId  String
  driver    Driver            @relation(fields: [driverId], references: [id], onDelete: Cascade)
  answers   Json              @default("{}")
  status    ApplicationStatus @default(pending)
  createdAt DateTime          @default(now())
  decidedAt DateTime?

  @@index([companyId, status])
  @@map("application")
}

model Rank {
  id            String  @id @default(cuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  minKm         Float
  color         String?
  discordRoleId String?

  @@unique([companyId, name])
  @@index([companyId, minKm])
  @@map("rank")
}

/// Counts for the company the driver was in when the job finished.
model Job {
  id            String         @id @default(cuid())
  driverId      String
  driver        Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deviceId      String?
  device        TrackerDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /// Id the tracker generated, so a retried upload never creates a second row.
  clientJobId   String
  game          Game
  multiplayer   Boolean        @default(false)
  sourceCity    String
  sourceCompany String
  destCity      String
  destCompany   String
  cargo         String
  cargoMassKg   Float
  plannedKm     Float
  drivenKm      Float
  odometerStart Float
  odometerEnd   Float
  /// In the game's currency: EUR for ETS2, USD for ATS.
  income        Int
  damagePct     Float
  maxSpeedKmh   Float
  startedAt     DateTime
  finishedAt    DateTime
  status        JobStatus
  /// Why the API flagged the job, if it did.
  flagReasons   String[]       @default([])
  /// What the tracker said (delivered or cancelled), kept so that approving a
  /// flagged job puts back the right status. Null on rows from before this.
  reportedAs    JobStatus?
  /// Set when a manager approved or rejected a flagged job.
  reviewedAt    DateTime?
  reviewedById  String?
  createdAt     DateTime       @default(now())

  events JobEvent[]

  @@unique([driverId, clientJobId])
  @@index([companyId, finishedAt])
  @@index([driverId, finishedAt])
  @@map("job")
}

model JobEvent {
  id      String   @id @default(cuid())
  jobId   String
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type    String
  at      DateTime
  payload Json     @default("{}")

  @@index([jobId])
  @@map("job_event")
}

model Goal {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title     String
  metric    GoalMetric
  target    Float
  startAt   DateTime
  endAt     DateTime

  @@index([companyId, endAt])
  @@map("goal")
}

/// Things that happened which the Discord bot posts about. The API writes a
/// row; apps/bot reads unprocessed rows, oldest first, and marks them done.
/// Payload shapes: packages/api/src/outbox.ts.
model OutboxEvent {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          String
  payload       Json
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  /// The three below are written by apps/bot only (apps/bot/src/outbox.ts).
  /// How many times the bot started on this row.
  attempts      Int       @default(0)
  /// Why the last try failed, or why a processed row was skipped or cut short.
  /// Null while a try is running.
  lastError     String?
  /// The bot leaves the row alone until then (a try in progress, or a wait before the next one).
  nextAttemptAt DateTime?

  @@index([processedAt, createdAt])
  @@map("outbox_event")
}

/// What the Discord bot already posted on a schedule, so a restart never
/// repeats it. kind "monthly_winners": key is the month ("2026-10").
/// kind "convoy_reminder": key is "<TruckersMP event id>:<day|hour>:<meet-up time>".
/// The row is written before the message is sent (apps/bot/src/ledger.ts).
model BotPost {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind      String
  key       String
  /// pending (being sent, or the bot stopped mid-send), posted, failed (will be
  /// retried), skipped (nothing to post), unknown (sent, but Discord never answered)
  status    String   @default("pending")
  detail    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, kind, key])
  @@index([kind, createdAt])
  @@map("bot_post")
}

/// What the Discord bot last found when it looked at a company's server, for
/// the settings screen to show. Written by apps/bot only.
model BotStatus {
  companyId     String    @id
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// The server id that was checked (Company.discordGuildId at the time).
  guildId       String?
  /// Whether the bot may act there: an owner or manager has Manage Server in it.
  guildOk       Boolean   @default(false)
  /// Why not, in plain words. Null when guildOk.
  guildReason   String?
  checkedAt     DateTime  @default(now())
  /// The last thing that went wrong after that check: a channel in another
  /// server, a missing permission, a rank role above the bot's own role.
  lastProblem   String?
  lastProblemAt DateTime?

  @@map("bot_status")
}

/// One per installed tracker, so a token can be revoked.
model TrackerDevice {
  id         String    @id @default(cuid())
  driverId   String
  driver     Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  name       String
  /// sha256 of the bearer token. The token itself is never stored.
  tokenHash  String    @unique
  appVersion String?
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  jobs Job[]

  @@index([driverId])
  @@map("tracker_device")
}

/// Short-lived pairing between the tracker app and a logged-in browser
/// (device-code flow: the app polls with deviceCode, the driver approves userCode).
model TrackerPairing {
  id             String    @id @default(cuid())
  deviceCodeHash String    @unique
  userCode       String    @unique
  deviceName     String
  appVersion     String?
  driverId       String?
  driver         Driver?   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  approvedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@map("tracker_pairing")
}
