# Production settings for docker-compose.prod.yml. On the server copy this to
# /opt/tacho/.env (chmod 600) and fill it in. Never commit the real file.
# All values below are placeholders.

# Prefix of container and volume names. Keep it once data exists.
COMPOSE_PROJECT_NAME=tacho

# ---- Site --------------------------------------------------------------------
# Public hostname. DNS A/AAAA records must point at the server before the first
# start, or Let's Encrypt cannot issue the certificate.
DOMAIN=tacho.example.com
# Let's Encrypt account e-mail (expiry warnings).
ACME_EMAIL=admin@example.com

# ---- Images ------------------------------------------------------------------
# ghcr.io/<owner>/<repo>, lower case. The deploy workflow pushes <prefix>/web
# and <prefix>/bot. TAG is set by deploy.sh (sha-<commit>); "latest" otherwise.
IMAGE_PREFIX=ghcr.io/your-github-owner/te-rebrand
TAG=latest

# ---- Database ----------------------------------------------------------------
# Goes into a URL: letters and digits only. Generate: openssl rand -hex 32
POSTGRES_PASSWORD=change-me-hex-only

# ---- Web app (see apps/web/.env.schema) ---------------------------------------
# At least 32 characters. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
# Discord application > OAuth2. Redirect URL to add there:
#   https://<DOMAIN>/api/auth/callback/discord
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=change-me
# Optional
STEAM_WEB_API_KEY=
TRACKER_DOWNLOAD_URL=
LIVE_MAP_ETS2_TILE_URL=
LIVE_MAP_ETS2_BOUNDS=
LIVE_MAP_ETS2_MAX_ZOOM=
LIVE_MAP_ETS2_TILE_SIZE=
LIVE_MAP_ETS2_ATTRIBUTION=
LIVE_MAP_ATS_TILE_URL=
LIVE_MAP_ATS_BOUNDS=
LIVE_MAP_ATS_MAX_ZOOM=
LIVE_MAP_ATS_TILE_SIZE=
LIVE_MAP_ATS_ATTRIBUTION=

# ---- Discord bot (see apps/bot/README.md) -------------------------------------
# Empty: the bot starts and stays idle.
DISCORD_BOT_TOKEN=

# ---- Backups (backup.sh) -----------------------------------------------------
# Local folder for the nightly dumps (kept BACKUP_KEEP_DAYS days).
BACKUP_DIR=/opt/tacho/backups
BACKUP_KEEP_DAYS=14
# Off-server copy: set one of these (or neither, to keep local copies only).
# rclone remote and path, e.g. an S3-compatible bucket configured with
# `rclone config` as "offsite":  offsite:tacho-backups/db
BACKUP_RCLONE_REMOTE=
# rsync target over SSH:  backup@backup.example.com:/srv/backups/tacho
BACKUP_RSYNC_TARGET=

# ---- Only for a local test of this stack ----------------------------------------
# HTTP_PORT=80
# HTTPS_PORT=443
